# Enable Google Sheets API, Google Calendar API, and Google Drive API on the same GCP project.
# Share every CRM spreadsheet (Editor) and every training calendar (Make changes to events)
# with the service account email.

# Service account. On Render use a Secret File at /etc/secrets/credentials.json
# or GOOGLE_SERVICE_ACCOUNT_JSON / GOOGLE_SERVICE_ACCOUNT_JSON_BASE64.
GOOGLE_SERVICE_ACCOUNT_EMAIL=crm-271@pappyjoe-crm.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/pappyjoe-crm-c1ce8651f5b1.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Optional push
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
